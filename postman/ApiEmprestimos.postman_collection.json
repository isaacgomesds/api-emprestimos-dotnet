            ],
            "url": {
              "raw": "{{baseUrl}}/loans/{{loanId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "loans",
                "{{loanId}}",
                "cancel"
              ]
            }
          }
        },
        {
          "name": "Get Book Loan History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}/history",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "{{bookId}}",
                "history"
              ]
            }
          }
        }
      ]
    }
  ]
