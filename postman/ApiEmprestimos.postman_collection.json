                "value": "application/json"
              },
              {
                "key": "X-Actor",
                "value": "{{actor}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{correlationId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Reader\",\n  \"email\": \"alex.reader@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Creates a user and stores the returned ID in the userId collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    const user = pm.response.json();",
                  "    if (user.id) pm.collectionVariables.set('userId', user.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get User Loan History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/loans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
