{
  "info": {
    "_postman_id": "04c86618-38c6-43bb-9e21-669e0d2021f8",
    "name": "ApiEmprestimos",
    "description": "Collection for the Library API. Run Create Book and Create User before creating a loan. The create requests store their returned IDs in collection variables. Return Loan and Cancel Loan are alternative actions for a loan.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5207",
      "type": "string"
    },
    {
      "key": "correlationId",
      "value": "9f19379b-3643-4eec-9db1-5306de5bc882",
      "type": "string"
    },
    {
      "key": "actor",
      "value": "librarian",
      "type": "string"
    },
    {
      "key": "bookId",
      "value": "11111111-1111-1111-1111-111111111111",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "22222222-2222-2222-2222-222222222222",
      "type": "string"
    },
    {
      "key": "loanId",
      "value": "33333333-3333-3333-3333-333333333333",
      "type": "string"
    },
    {
      "key": "idempotencyKey",
      "value": "7da7c83d-99d9-4664-b1fa-5d957d169e57",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Books",
      "item": [
        {
          "name": "Create Book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Actor",
                "value": "{{actor}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{correlationId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Left Hand of Darkness\",\n  \"isbn\": \"9780441478125\",\n  \"author\": \"Ursula K. Le Guin\",\n  \"totalCopies\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            },
            "description": "Creates a book and stores the returned ID in the bookId collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    const book = pm.response.json();",
                  "    if (book.id) pm.collectionVariables.set('bookId', book.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Active Books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            }
          }
        },
        {
          "name": "Get Book by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "{{bookId}}"
              ]
            }
          }
        },
        {
          "name": "Update Book",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Actor",
                "value": "{{actor}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{correlationId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Left Hand of Darkness (Library Edition)\",\n  \"author\": \"Ursula K. Le Guin\",\n  \"totalCopies\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "{{bookId}}"
              ]
            }
          }
        },
        {
          "name": "Deactivate Book",
          "request": {
            "method": "DELETE",
            "header": [
              {
