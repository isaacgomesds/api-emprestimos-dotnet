                            }
                        }
                    ]
                },
                {
                    "name": "Readiness Check",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/health/ready",
                            "host": ["{{baseUrl}}"],
                            "path": ["health", "ready"]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Readiness returns HTTP 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test('PostgreSQL and Redis are healthy', function () {",
                                    "    const response = pm.response.json();",
                                    "    pm.expect(response.status).to.eql('Healthy');",
                                    "    const checks = response.checks.reduce(function (result, check) {",
                                    "        result[check.name.toLowerCase()] = check.status;",
                                    "        return result;",
                                    "    }, {});",
                                    "    pm.expect(checks.postgresql).to.eql('Healthy');",
                                    "    pm.expect(checks.redis).to.eql('Healthy');",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Prometheus Metrics",
                    "request": {
                        "method": "GET",
