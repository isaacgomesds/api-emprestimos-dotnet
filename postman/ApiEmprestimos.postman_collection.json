    },
    {
      "name": "Loans",
      "item": [
        {
          "name": "Create Loan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}",
                "description": "Use the same key when retrying the same loan request."
              },
              {
                "key": "X-Actor",
                "value": "{{actor}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{correlationId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": \"{{bookId}}\",\n  \"userId\": \"{{userId}}\",\n  \"loanDateUtc\": \"2026-10-20T00:00:00Z\",\n  \"dueDateUtc\": \"2026-11-03T00:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/loans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "loans"
              ]
            },
            "description": "Create a loan after creating a book and user. Reuse the Idempotency-Key only when retrying the same request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    const loan = pm.response.json();",
                  "    if (loan.id) pm.collectionVariables.set('loanId', loan.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Return Loan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Actor",
                "value": "{{actor}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{correlationId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/loans/{{loanId}}/return",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "loans",
                "{{loanId}}",
                "return"
              ]
            }
          }
        },
        {
          "name": "Cancel Loan",
          "request": {
            "method": "POST",
