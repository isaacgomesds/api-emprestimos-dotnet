                            "path": ["users"]
                        },
                        "description": "Creates a user and stores the returned ID in the userId collection variable."
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code >= 200 && pm.response.code < 300) {",
                                    "    const user = pm.response.json();",
                                    "    if (user.id) pm.collectionVariables.set('userId', user.id);",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Get User Loan History",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/users/{{userId}}/loans",
                            "host": ["{{baseUrl}}"],
                            "path": ["users", "{{userId}}", "loans"]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('User loan history returns HTTP 200 and an array', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    pm.expect(pm.response.json()).to.be.an('array');",
                                    "});",
                                    "",
                                    "pm.test('Each loan includes book title, author, and ISBN', function () {",
                                    "    pm.response.json().forEach(function (loan) {",
                                    "        pm.expect(loan).to.have.property('bookTitle').that.is.a('string').and.not.empty;",
                                    "        pm.expect(loan).to.have.property('bookAuthor').that.is.a('string').and.not.empty;",
                                    "        pm.expect(loan).to.have.property('isbn').that.is.a('string').and.not.empty;",
                                    "    });",
                                    "});"
                                ]
                            }
